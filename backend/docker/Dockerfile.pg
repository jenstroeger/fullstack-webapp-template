# https://hub.docker.com/_/alpine
FROM alpine:3.23.3@sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659 AS build

# https://pkgs.alpinelinux.org/packages
RUN apk update && \
  apk add git curl gcc openssl make && \
  apk add postgresql18-dev file-dev libpq-dev

# https://github.com/michelp/pgjwt
RUN cd /tmp && \
  git clone --branch master --depth 1 https://github.com/michelp/pgjwt.git && \
  cd pgjwt && make install

# https://github.com/nmandery/pg_byteamagic
RUN cd /tmp && \
  git clone --branch master --depth 1 https://github.com/nmandery/pg_byteamagic.git && \
  cd pg_byteamagic && make install

# https://hub.docker.com/_/postgres
FROM postgres:18.3-alpine3.23@sha256:4da1a4828be12604092fa55311276f08f9224a74a62dcb4708bd7439e2a03911

RUN apk update && \
  apk add libmagic

COPY --from=build /usr/share/postgresql18/extension/byteamagic* /usr/share/postgresql18/extension/pgflake* /usr/share/postgresql18/extension/pgjwt* /usr/local/share/postgresql/extension/
COPY --from=build /usr/lib/postgresql18/byteamagic* /usr/lib/postgresql18/pgflake* /usr/lib/postgresql18/bitcode /usr/local/lib/postgresql/
